# StockHub environment variables. Copy to `.env` (repo root) and fill in.
# `.env` is git-ignored; production values live in Vercel / Cloud Run / Secret Manager.
# Read by: dbmate (make migrate), Python (stockhub.common.settings), Next.js (web/next.config.ts).

# ---------------------------------------------------------------- runtime
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------- database
# Postgres URL (postgresql:// scheme). Local: docker compose or scripts/local-pg.sh (port 5433).
# Neon: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://stockhub:stockhub@localhost:5433/stockhub?sslmode=disable
# Database used by pytest; it is migrated and truncated by the test suite. Never point at production.
TEST_DATABASE_URL=postgresql://stockhub:stockhub@localhost:5433/stockhub_test?sslmode=disable

# ---------------------------------------------------------------- auth (web)
# Auth.js session encryption key. Generate: `openssl rand -base64 33`
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: <site origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated list of emails allowed to sign in (case-insensitive). Empty = nobody.
ALLOWED_EMAIL=
# Local-only: skip login entirely (ignored on Vercel and in production builds other than the
# one stockhub.bat starts on 127.0.0.1; docs/DECISIONS.md D-117).
AUTH_DISABLED=false
# Set to true behind a proxy / on non-Vercel hosts so Auth.js trusts the Host header.
AUTH_TRUST_HOST=true
# local = the site starts queued data jobs itself (scripts/scheduled.sh etl-requests); ignored
# on Vercel and in deployed production builds, where requests wait for the next scheduled etl-daily.
JOB_RUNNER=
# Git Bash used by JOB_RUNNER=local on Windows (default: Git for Windows' bin/bash.exe).
JOB_RUNNER_BASH=

# ---------------------------------------------------------------- RawStore
# local | gcs
RAWSTORE_BACKEND=local
# local backend: directory for raw objects (relative to the repo root or absolute)
RAWSTORE_LOCAL_DIR=.local/rawstore
# gcs backend: bucket name; credentials come from Application Default Credentials
RAWSTORE_GCS_BUCKET=

# ---------------------------------------------------------------- notifications
# console | email
NOTIFIER=console
# Recipient(s) for ETL alerts, comma-separated
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# true = STARTTLS on SMTP_PORT (587); false with port 465 = implicit TLS
SMTP_STARTTLS=true

# ---------------------------------------------------------------- data providers
# Primary-then-fallback order per data type (comma-separated provider names).
# Official sources: twse (TWSE, also serves the ISIN master list for both markets), tpex (TPEx).
PROVIDERS_PRICE=twse,tpex
# Per-company statement history (IS/BS/CF): finmind. Official sources only serve the latest
# quarter (PROVIDERS_FINANCIAL_SNAPSHOT); MOPS disallows crawling in robots.txt.
PROVIDERS_FINANCIAL=finmind
# Latest filed quarter of every general company, as filed (OpenAPI t187ap06/07): both needed.
PROVIDERS_FINANCIAL_SNAPSHOT=twse,tpex
# Monthly revenue history per company / latest month of every company (OpenAPI t187ap05).
PROVIDERS_MONTHLY_REVENUE=finmind
PROVIDERS_MONTHLY_REVENUE_SNAPSHOT=twse,tpex
# Company profiles: par value, issued shares, industry code (OpenAPI t187ap03): both needed.
PROVIDERS_COMPANY_PROFILES=twse,tpex
# Intraday snapshots: twse_mis (TWSE MIS feed, serves both markets).
PROVIDERS_QUOTE=twse_mis
# Streaming quote sources (broker market data, read-only), first = primary; empty = poll only.
# poll_quotes keeps one session open and falls back to polling PROVIDERS_QUOTE (D-123).
PROVIDERS_QUOTE_STREAM=
# QUOTE_STREAM_RECONNECT_ATTEMPTS=5
# QUOTE_STREAM_RECONNECT_MAX_DELAY=30
# QUOTE_STREAM_FALLBACK_COOLDOWN=300
# QUOTE_STREAM_STALE_AFTER=120
PROVIDERS_CALENDAR=twse
PROVIDERS_SECURITIES=twse
# Delisted companies: twse serves TWSE, tpex serves TPEx (both needed).
PROVIDERS_DELISTINGS=twse,tpex
# Ex-rights/dividends, capital reductions, par-value changes, ETF splits (both needed).
PROVIDERS_CORPORATE_ACTIONS=twse,tpex
# Cash / stock / rights parts of TWSE 權息 events since 2009 (TPEx tables already have them).
PROVIDERS_DIVIDEND_DETAILS=twse
# 除權除息預告表 (sync_ex_rights_previews): TWSE OpenAPI TWT48U_ALL, TPEx OpenAPI tpex_exright_prepost
PROVIDERS_EX_RIGHTS_PREVIEWS=twse,tpex
# Chips (M4): 三大法人 (T86 / insti/dailyTrade), margin, foreign holdings, market totals
PROVIDERS_INSTITUTIONAL_TRADES=twse,tpex
PROVIDERS_MARGIN=twse,tpex
PROVIDERS_FOREIGN_HOLDINGS=twse,tpex
PROVIDERS_MARKET_INSTITUTIONAL=twse,tpex
# TDCC weekly shareholding distribution (集保戶股權分散表, latest week only)
PROVIDERS_SHAREHOLDING_DISTRIBUTION=tdcc
# Market series (M5): each series uses the listed sources that serve it, in this order.
# twse = 加權指數 (MI_5MINS_HIST), tpex = 櫃買指數, yahoo = chart API, fred = St. Louis Fed CSV
PROVIDERS_MARKET_SERIES=twse,tpex,yahoo,fred
# 國發會景氣指標及燈號 (data.gov.tw 6099)
PROVIDERS_MACRO_RELEASE=ndc

# ---------------------------------------------------------------- FinMind
# Token from finmindtrade.com (free account: 600 requests/hour). Empty = anonymous (300/hour).
FINMIND_TOKEN=
# Our own ceiling per hour, kept below the account limit (also shared across processes).
FINMIND_REQUESTS_PER_HOUR=500

# ---------------------------------------------------------------- service-to-service (reserved, M7)
# Shared secret the Next.js server uses to call the FastAPI screener/backtest service.
SERVICE_AUTH_SECRET=
