# StockHub environment variables. Copy to `.env` (repo root) and fill in.
# `.env` is git-ignored; production values live in Vercel / Cloud Run / Secret Manager.
# Read by: dbmate (make migrate), Python (stockhub.common.settings), Next.js (web/next.config.ts).

# ---------------------------------------------------------------- runtime
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------- database
# Postgres URL (postgresql:// scheme). Local: docker compose or scripts/local-pg.sh (port 5433).
# Neon: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://stockhub:stockhub@localhost:5433/stockhub?sslmode=disable
# Database used by pytest; it is migrated and truncated by the test suite. Never point at production.
TEST_DATABASE_URL=postgresql://stockhub:stockhub@localhost:5433/stockhub_test?sslmode=disable

# ---------------------------------------------------------------- auth (web)
# Auth.js session encryption key. Generate: `openssl rand -base64 33`
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: <site origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated list of emails allowed to sign in (case-insensitive). Empty = nobody.
ALLOWED_EMAIL=
# Set to true behind a proxy / on non-Vercel hosts so Auth.js trusts the Host header.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------- RawStore
# local | gcs
RAWSTORE_BACKEND=local
# local backend: directory for raw objects (relative to the repo root or absolute)
RAWSTORE_LOCAL_DIR=.local/raw
# gcs backend: bucket name; credentials come from Application Default Credentials
RAWSTORE_GCS_BUCKET=

# ---------------------------------------------------------------- notifications
# console | email
NOTIFIER=console
# Recipient(s) for ETL alerts, comma-separated
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# true = STARTTLS on SMTP_PORT (587); false with port 465 = implicit TLS
SMTP_STARTTLS=true

# ---------------------------------------------------------------- data providers
# Primary-then-fallback order per data type (comma-separated provider names).
# M0 only ships fake providers; real adapters arrive in M1+.
PROVIDERS_PRICE=fake
PROVIDERS_FINANCIAL=
PROVIDERS_QUOTE=

# ---------------------------------------------------------------- service-to-service (reserved, M7)
# Shared secret the Next.js server uses to call the FastAPI screener/backtest service.
SERVICE_AUTH_SECRET=
